# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Loaded and validated exclusively by packages/config — execution code
# never reads process.env directly.

# --- Solana (adapters/solana) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Base58-encoded secret key of the issuing keypair. Generate with:
#   solana-keygen new --outfile /tmp/vbel-issuer.json
#   node -e "console.log(require('bs58').encode(Buffer.from(require('/tmp/vbel-issuer.json'))))"
# Then fund it: solana airdrop 1 <pubkey> --url devnet
SOLANA_ISSUER_SECRET_KEY=

# --- ENS (adapters/ens) ---
# Read-only resolution (resolveIssuerRecords) needs only ENS_RPC_URL.
# Write access (createSubname / setRecords) additionally needs the two
# fields below. Defaults to sepolia — a real value here is what turns on
# spend authority, so leave the rest blank until you mean it.
ENS_RPC_URL=https://sepolia.gateway.tenderly.co
ENS_NETWORK=sepolia
# Must already be registered and owned by ENS_OWNER_PRIVATE_KEY.
ENS_PARENT_NAME=
# 0x-prefixed private key of the owning wallet. Never committed.
ENS_OWNER_PRIVATE_KEY=
