# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Loaded and validated exclusively by packages/config — execution code
# never reads process.env directly.

# --- Solana (adapters/solana) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Base58-encoded secret key of the issuing keypair.
# Generate and fund with: pnpm --filter @vbel/adapter-solana init:devnet
SOLANA_ISSUER_SECRET_KEY=

# --- ENS (adapters/ens) ---
# Three access levels, deliberately separated:
#   read  — resolving names and records. Needs ENS_RPC_URL only.
#   owner — can sign, owns no name yet. Adds ENS_OWNER_PRIVATE_KEY.
#           This is what name registration needs.
#   write — owns a parent name. Adds ENS_PARENT_NAME.
# Defaults to sepolia; mainnet spends real ETH and must be set explicitly.
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_NETWORK=sepolia
# Generate and fund with: pnpm --filter @vbel/adapter-ens init:owner
ENS_OWNER_PRIVATE_KEY=
# Register with:  pnpm --filter @vbel/adapter-ens register:parent -- <label>
ENS_PARENT_NAME=
